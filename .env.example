# Copy this file to .env and replace the placeholders.
# Never commit .env — it is gitignored.

# --- CCG credentials (Developer Console → your Platform App → Configuration)
# Client secret viewing requires 2FA on your Box account.
BOX_CLIENT_ID=your_client_id
BOX_CLIENT_SECRET=your_client_secret
# Enterprise ID is on the same Configuration / General page.
BOX_ENTERPRISE_ID=your_enterprise_id

# --- After python setup_test_data.py, paste the printed values below.
# Or use a folder the service account can read (folder ID from the Box URL).
FOLDER_ID=your_folder_id

# Template reference: enterprise_<enterpriseId>:<templateKey>
TEMPLATE_KEY=sales
TEMPLATE_REF=enterprise_12345678:sales

# Field paths: enterprise_<enterpriseId>:<templateKey>:<fieldKey>
FIELD_CONTRACT_TYPE=enterprise_12345678:sales:contractType
FIELD_CONTRACT_VALUE=enterprise_12345678:sales:contractValue
