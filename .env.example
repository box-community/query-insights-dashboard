# Box CCG credentials (Developer Console → your Platform App)
BOX_CLIENT_ID=your_client_id
BOX_CLIENT_SECRET=your_client_secret
BOX_ENTERPRISE_ID=your_enterprise_id

# Folder that scopes insights queries (ancestors)
FOLDER_ID=your_folder_id

# Metadata template — form: enterprise_<id>:<templateKey>
TEMPLATE_KEY=your_template_key
TEMPLATE_REF=enterprise_12345678:sales

# Metadata field paths — form: enterprise_<id>:<templateKey>:<fieldKey>
FIELD_CONTRACT_TYPE=enterprise_12345678:sales:contractType
FIELD_CONTRACT_VALUE=enterprise_12345678:sales:contractValue
